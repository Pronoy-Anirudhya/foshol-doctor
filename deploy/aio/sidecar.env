# LIVE + visionary pins for the bundled sidecar, mirroring docker-compose.dev.yml.
#
# Sourced ONLY by start-sidecar.sh and the bake stage — never exported as image ENV.
# In a single container every process inherits the container environment, and Spring
# relaxed binding maps FOSHOL_AI_VISION_RICE_MODEL_ID onto the app's own
# foshol.ai.vision.rice.model-id, which KnowledgeContentValidator checks against
# model_label_map. Leaking these would silently move the app's content gate.
FOSHOL_AI_MODE=live
FOSHOL_SIDECAR_VISION_BACKEND=visionary
# LIVE vision loads only vision.rice.primary, so every crop routes to the rice family.
FOSHOL_AI_VISION_CROP_ROUTES=rice=rice,tomato=rice,potato=rice,corn=rice,wheat=rice
# This revision must match V112__visionaryquant_label_map.sql exactly, or every
# prediction resolves to UNDETERMINED through a designed-and-silent path.
FOSHOL_AI_VISION_RICE_MODEL_ID=VisionaryQuant/5_Crop_Disease_Detection
FOSHOL_AI_VISION_RICE_MODEL_REVISION=63080391f7d2bdb331ab356b0d1d9b4b603b3946
# Config-validated but never loaded in LIVE; weights are deliberately not baked.
FOSHOL_AI_VISION_RICE_FALLBACK_MODEL_ID=prithivMLmods/Rice-Leaf-Disease
FOSHOL_AI_VISION_RICE_FALLBACK_MODEL_REVISION=170d10e070c308e0e5337690d67371825591f35b
FOSHOL_AI_VISION_SOLANACEAE_MODEL_ID=Daksh159/plant-disease-mobilenetv2
FOSHOL_AI_VISION_SOLANACEAE_MODEL_REVISION=d3fb2afc90da83086eff06e9088a889b6c43d4a6
FOSHOL_AI_ASR_MODEL_ID=ashrafulparan/whisper-small-bangla
FOSHOL_AI_ASR_MODEL_REVISION=25c88973563146654493b97882fb2806d2fdeaaa
FOSHOL_AI_EMBED_MODEL_ID=sentence-transformers/LaBSE
FOSHOL_AI_EMBED_MODEL_REVISION=836121a0533e5664b21c7aacc5d22951f2b8b25b
FOSHOL_SIDECAR_FIXTURE_DIR=/app/fixtures
FOSHOL_SIDECAR_TORCH_THREADS=4
OMP_NUM_THREADS=4
HF_HOME=/opt/foshol/hf-cache
HF_HUB_DISABLE_TELEMETRY=1
# The weights are baked. Offline at runtime means a cache miss fails loudly instead of
# silently downloading into the container layer. The bake stage overrides both to 0.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
