# Copy to .env on the VM. Do not commit real values.
# docker compose -f docker-compose.dev.yml up -d --build --wait

FOSHOL_JWT_SECRET=replace-with-at-least-32-characters
FOSHOL_PHONE_KEY=replace-with-32-byte-base64-aes-key==
FOSHOL_DB_PASSWORD=replace-me
FOSHOL_DB_USER=foshol
FOSHOL_MINIO_ACCESS_KEY=replace-minio-access
FOSHOL_MINIO_SECRET_KEY=replace-minio-secret

DB_URL=jdbc:postgresql://postgres:5432/foshol
SIDECAR_BASE_URL=http://sidecar:8000
# The browser-reachable S3 API origin of MinIO, NOT the "minio" compose service name. A
# presigned URL is signed over its Host header, so this value IS the host the browser must
# resolve; an internal name makes every image fail with ERR_NAME_NOT_RESOLVED, and the host
# cannot be patched into an already-signed URL. Use the VM's own address and MinIO's API port
# 9000 — 9001 is the console and does not serve presigned objects. Keep this in step with the
# frontend's MEDIA_OBJECT_STORE_ORIGIN, which allow-lists the same origin in its CSP.
MINIO_ENDPOINT=http://10.0.0.12:9000
SPRING_PROFILES_ACTIVE=dev

HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
FOSHOL_SIDECAR_TORCH_THREADS=4
