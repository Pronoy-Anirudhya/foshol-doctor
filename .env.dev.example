# Copy to .env on the VM. Do not commit real values.
# docker compose -f docker-compose.dev.yml up -d --build --wait

FOSHOL_JWT_SECRET=replace-with-at-least-32-characters
FOSHOL_PHONE_KEY=replace-with-32-byte-base64-aes-key==
FOSHOL_DB_PASSWORD=replace-me
FOSHOL_DB_USER=foshol
FOSHOL_MINIO_ACCESS_KEY=replace-minio-access
FOSHOL_MINIO_SECRET_KEY=replace-minio-secret

DB_URL=jdbc:postgresql://postgres:5432/foshol
SIDECAR_BASE_URL=http://sidecar:8000
MINIO_ENDPOINT=http://minio:9000
SPRING_PROFILES_ACTIVE=dev

HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
FOSHOL_SIDECAR_TORCH_THREADS=4
